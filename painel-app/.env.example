# Banco de dados (MySQL da Hostinger: use 127.0.0.1 a partir do app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u277642544_painel
DB_USER=u277642544_painel
DB_PASSWORD=

# Segredo das sessões (texto aleatório longo)
SECRET=

# Primeiro administrador (criado só se não existir nenhum usuário)
ADMIN_EMAIL=contato@neonsistemas.com
ADMIN_PASSWORD=

# Endereço público do painel (usado pelas redes sociais e pelo Telegram)
PUBLIC_URL=https://painel.neonsistemas.com

# Pasta dos arquivos enviados (fora do código, para não sumir em novas publicações)
STORAGE_DIR=/home/u277642544/domains/painel.neonsistemas.com/storage
MAX_UPLOAD_MB=2048

# Chave do disparo externo dos robôs: /publico/cron/CRON_KEY
CRON_KEY=
